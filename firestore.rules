rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlayerProgress(data, userId) {
      return data.keys().hasAll(['uid', 'playerName', 'unlockedEndings', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'playerName', 'unlockedEndings', 'updatedAt'])
        && data.uid is string
        && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 24
        && data.unlockedEndings is list
        && data.unlockedEndings.size() >= 0
        && data.unlockedEndings.size() <= 4
        && data.unlockedEndings.hasOnly(['ALL_FIGHT', 'ALL_SPARE', 'MIXED', 'SECRET_PIRATE'])
        && data.updatedAt == request.time;
    }

    match /userProgress/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProgress(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['unlockedEndings', 'playerName', 'updatedAt']);
      allow delete: if false;
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow list, write: if false;
    }
  }
}
